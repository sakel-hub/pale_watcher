{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT",
    "pathStrict": true
  },
  "diagnostics": {
    "enable": true,
    "globals": [
      "core",
      "minetest",
      "pale_watcher",
      "x_mob_core",
      "vector",
      "ItemStack",
      "DIR_DELIM",
      "player_monoids",
      "playerphysics",
      "pova",
      "default"
    ],
    "disable": [
      "lowercase-global"
    ],
    "neededFileStatus": {
      "codestyle-check": "Any"
    },
    "libraryFiles": "Disable"
  },
  "format": {
    "enable": true,
    "defaultConfig": {
      "indent_style": "tab",
      "tab_width": "4"
    }
  },
  "workspace": {
    "checkThirdParty": false,
    "userThirdParty": [],
    "useGitIgnore": true,
    "ignoreSubmodules": true,
    "maxPreload": 5000,
    "preloadFileSize": 1000,
    "ignoreDir": [
      ".git",
      "assets",
      "scratch",
      "scripts",
      "test.lua",
      "tests"
    ]
  },
  "doc": {
    "packageName": "pale_watcher"
  }
}
